D::HemisphereLight","name":"3D Ambient Hemisphere Light","doubleParameters":{"elevation":40,"intensity":0.33,"rotation":300},"stringParameters":{"groundColor":"127;127;127","skyColor":"255;255;255","top":"Z+"},"booleanParameters":{}},{"effectType":"Scene3D::DirectionalLight","name":"3D Sun Light","doubleParameters":{"distanceFromCamera":1500,"elevation":40,"frustumSize":4000,"intensity":0.75,"minimumShadowBias":0,"rotation":300},"stringParameters":{"color":"255;255;255","shadowQuality":"medium","top":"Z+"},"booleanParameters":{"isCastingShadow":true}}]}],"behaviorsSharedData":[{"name":"Animation","type":"AnimatableCapability::AnimatableBehavior"},{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"Flippable","type":"FlippableCapability::FlippableBehavior"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Physics2","type":"Physics2::Physics2Behavior","gravityX":0,"gravityY":9.8,"worldScale":100,"scaleX":100,"scaleY":100},{"name":"Platform","type":"PlatformBehavior::PlatformBehavior"},{"name":"PlatformerObject","type":"PlatformBehavior::PlatformerObjectBehavior"},{"name":"Resizable","type":"ResizableCapability::ResizableBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"}]}],"externalEvents":[],"tests":[{"description":"Verifica que el jugador permanece sobre el piso y dentro del mapa tras varios frames","lastRunAt":1788735709485,"lastRunDurationMs":939,"lastRunFramesExecuted":121,"lastRunStatus":"passed","name":"Jugador no sale del mapa","type":"gameplay","source":["await harness.goToScene('Escena sin título');","await harness.stepFrames(120);","const player = harness.getObjects('jugador')[0];","harness.assert(player, 'El jugador existe en la escena');","harness.assert(player.y > 0 && player.y < 720, `El jugador esta dentro de la pantalla (y=${player.y})`);","// El jugador debe estar de pie sobre el piso (borde superior del piso en Y=656, jugador ~78 alto)","harness.assert(player.y > 500 && player.y < 660, `El jugador esta sobre el piso (y=${player.y})`);","// No debe haberse ido volando fuera del mapa","harness.assert(player.x > 0 && player.x < 1280, `El jugador esta dentro del ancho del mapa (x=${player.x})`);"]},{"description":"Comprueba que el jugador se mueve a la derecha, que las cajas son sólidas y que recolecta monedas incrementando el contador","lastRunAt":1788736184832,"lastRunDurationMs":1255,"lastRunFramesExecuted":91,"lastRunStatus":"failed","name":"Movimiento, salto y monedas","type":"gameplay","source":["await harness.goToScene('Escena sin título');","await harness.stepFrames(10);","","// --- Movimiento con teclado ---","const p0 = harness.getObjects('jugador')[0];","harness.setKeyPressed('Right', true);","let moved = false;","for (let f = 0; f < 40; f++) {","  await harness.stepFrames(1);","  const p = harness.getObjects('jugador')[0];","  if (p.x > p0.x + 60) { moved = true; break; }","}","harness.setKeyPressed('Right', false);","harness.assert(moved, 'El jugador se mueve hacia la derecha con la tecla Right');","","// --- Las cajas son sólidas (jugador puede estar encima) ---","const boxes = harness.getObjects('caja');","const b = boxes[0];","const player = harness.getObjects('jugador')[0];","harness.setObjectPosition(player.id, b.centerX, b.y - 80);","await harness.stepFrames(60);","const after = harness.getObjects('jugador')[0];","// en 60 frames con gravedad caeria mucho; si la caja es solida quedaria apoyado cerca de la parte superior","harness.assert(after.y > b.y - 85 && after.y < b.y, `El jugador cae y se apoya sobre la caja (jugador.y=${after.y}, caja.y=${b.y})`);","","// --- Recoleccion de monedas ---","const coins = harness.getObjects('moneda');","if (coins.length > 0) {","  const coin = coins[0];","  const p2 = harness.getObjects('jugador')[0];","  harness.setObjectPosition(p2.id, coin.centerX, coin.centerY);","  await harness.stepFrames(3);","  const monedasVar = harness.getSceneVariable('Monedas');","  harness.assert(monedasVar && monedasVar.value > 0, `El contador de monedas aumenta tras tocar una moneda (Monedas=${monedasVar ? monedasVar.value : 'sin var'})`);","} else {","  harness.fail('No hay monedas en la escena');","}"]},{"description":"Verifica que el jugador puede pararse encima de una caja","lastRunAt":1788736269328,"lastRunDurationMs":983,"lastRunFramesExecuted":32,"lastRunStatus":"passed","name":"Cajas solidas verificacion","type":"gameplay","source":["await harness.goToScene('Escena sin título');","await harness.stepFrames(5);","const boxes = harness.getObjects('caja');","// Elegir la caja mas cercana al suelo (mayor y)","let b = boxes[0];","for (const bx of boxes) if (bx.y > b.y) b = bx;","const player = harness.getObjects('jugador')[0];","// Colocar al jugador justo encima de la caja","const px = b.x + (b.width - player.width) / 2;","const py = b.y - player.height;","harness.setObjectPosition(player.id, px, py);","await harness.stepUntilObjectIsStable('jugador', { tolerance: 2, stableFrames: 20, maxFrames: 120 });","const after = harness.getObjects('jugador')[0];","// El jugador debe quedar apoyado: su borde inferior cerca del borde superior de la caja","const playerBottom = after.y + after.height;","harness.assert(Math.abs(playerBottom - b.y) < 8, `El jugador queda apoyado sobre la caja (jugadorBottom=${playerBottom}, cajaTop=${b.y})`);","harness.assert(after.y > b.y - player.height - 10, 'El jugador no atraviesa la caja');"]}],"eventsFunctionsExtensions":[],"externalLayouts":[]}